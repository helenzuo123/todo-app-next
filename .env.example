# Supabase 配置
# 🔒 注意：这是一个示例文件，请勿直接使用这些值！

# Supabase 项目 URL
# 获取方式：Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co

# Supabase 匿名密钥（Anon Key）
# 获取方式：Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ 设置步骤：
# 1. 复制此文件并重命名为 .env.local
# 2. 将上面的占位符替换为你的实际 Supabase 凭证
# 3. 确保 .env.local 已被添加到 .gitignore（不要提交到 git）
#
# 📖 更多信息：
# - Supabase 文档: https://supabase.com/docs
# - Next.js 环境变量: https://nextjs.org/docs/basic-features/environment-variables
